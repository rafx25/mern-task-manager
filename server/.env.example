NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Prefer the mongodb+srv:// form. If local DNS refuses SRV lookups
# (querySrv ECONNREFUSED), switch to the non-SRV string from Atlas by
# turning off "SRV Connection String" in the Connect dialog.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.8dx4rcd.mongodb.net/<dbname>?appName=Cluster0

JWT_SECRET=generate-with-openssl-rand-base64-32